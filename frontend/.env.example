# Base URL of the Express backend. next.config.mjs rewrites /api/:path* to
# this origin (same-origin requests from the browser). Defaults to
# http://localhost:5000 when unset (backend PORT in backend/.env).
API_BASE_URL=http://localhost:5000

# Confirmed canonical site origin, including on preview deployments.
SITE_URL=https://afarhorizon.com
# Only the verified production deployment may enable indexing.
SEO_INDEXABLE=false
# Use preview/staging for nonproduction deployments. Vercel/Netlify preview
# markers override production here and always force noindex.
DEPLOYMENT_ENV=development
# Production hosting: SEO_INDEXABLE=true and DEPLOYMENT_ENV=production.
