# Base URL of the Express backend. next.config.mjs rewrites /api/:path* to
# this origin (same-origin requests from the browser). Defaults to
# http://localhost:5000 when unset (backend PORT in backend/.env).
API_BASE_URL=http://localhost:5000

# Confirmed canonical site origin, including on preview deployments.
SITE_URL=https://www.afarhorizon.com
# Only the verified production deployment may enable indexing.
SEO_INDEXABLE=false
# Use preview/staging for nonproduction deployments. Vercel/Netlify preview
# markers override production here and always force noindex.
DEPLOYMENT_ENV=development
# Production hosting: SEO_INDEXABLE=true and DEPLOYMENT_ENV=production.

# Optional URL-prefix Search Console HTML verification: token only, not the tag.
# Domain-property verification uses Google's DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=

# Vercel page views run only with VERCEL_ENV=production (provided by Vercel).
# Set false to disable the existing cookie-free analytics service.
ANALYTICS_ENABLED=true
# Confirmed plan is Hobby: leave custom events disabled. Vercel custom events
# need Pro/Enterprise; enable only after the owner chooses a supported plan/provider.
ANALYTICS_CUSTOM_EVENTS_ENABLED=false
